rules_version = '2';
// Reglas de seguridad – App Sindicato N°2 Minera Pacífico del Sur SpA
// Solo socios aprobados leen el contenido; solo administradores (colección admins) publican y aprueban.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function isActive() { return signedIn() && get(/databases/$(db)/documents/socios/$(request.auth.uid)).data.estado == 'activo'; }
    function contenido(col) { return col in ['informativos','noticias','eventos','encuestas','beneficios','documentos','directiva','config','fotos']; }

    // admins: rol 'administrador' (dueño de la app, creado en la consola) o 'dirigente' (nombrado por el administrador)
    function isOwner() { return signedIn() && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.rol == 'administrador'; }
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isOwner() && request.resource.data.rol == 'dirigente' && request.resource.data.keys().hasOnly(['rol']);
      allow delete: if isOwner() && resource.data.rol == 'dirigente';
    }
    match /socios/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.keys().hasOnly(['nombre','rut','num','telefono','email','estado','creado']);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);   // el socio puede borrar su propia cuenta
    }
    match /{col}/{id} {
      allow read: if contenido(col) && (isActive() || isAdmin());
      allow write: if contenido(col) && isAdmin();
    }
    // Plantillas de citaciones y eventos: solo administrador y dirigentes
    match /plantillas/{id} { allow read, write: if isAdmin(); }
    // Asistencia a reuniones: la directiva crea y cierra; cada socio marca con el código mientras el registro está abierto
    match /asistencias/{rid} {
      allow read: if isActive() || isAdmin();
      allow write: if isAdmin();
      match /privado/{doc} {
        allow read, write: if isAdmin();
      }
      match /presentes/{uid} {
        allow read: if isActive() || isAdmin();
        allow create: if isAdmin() || (isActive() && request.auth.uid == uid
          && get(/databases/$(db)/documents/asistencias/$(rid)).data.abierta == true
          && request.resource.data.codigo == get(/databases/$(db)/documents/asistencias/$(rid)/privado/clave).data.codigo
          && request.resource.data.via == 'codigo'
          && request.resource.data.keys().hasOnly(['nombre','num','codigo','via','t']));
        allow update, delete: if isAdmin();
      }
    }
    // Me gusta y comentarios en informativos: cada socio activo con su propio nombre; borra el autor o la directiva
    function miNombre() { return get(/databases/$(db)/documents/socios/$(request.auth.uid)).data.nombre; }
    match /informativos/{pid}/likes/{uid} {
      allow read: if isActive() || isAdmin();
      allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['nombre','t'])
        && (isAdmin() || (isActive() && request.resource.data.nombre == miNombre()));
      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update: if false;
    }
    match /informativos/{pid}/comentarios/{cid} {
      allow read: if isActive() || isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','nombre','num','texto','t'])
        && request.resource.data.texto is string && request.resource.data.texto.size() > 1 && request.resource.data.texto.size() <= 500
        && exists(/databases/$(db)/documents/informativos/$(pid))
        && (isAdmin() || (isActive() && request.resource.data.nombre == miNombre()));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /encuestas/{pid}/votos/{uid} {
      allow read: if isActive() || isAdmin();
      allow create: if (isActive() || isAdmin()) && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['opcion','t']);
      allow update, delete: if false;      // un voto por socio, sin cambios
    }
  
    // ===== Plataforma multi-sindicato: cada sindicato en sindicatos/{sid}, con sus propios socios y directiva =====
    function isSuper() { return signedIn() && exists(/databases/$(db)/documents/admins/$(request.auth.uid))
      && get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.rol == 'administrador'; }
    match /sindicatos/{sid} {
      allow get: if true;                 // nombre, colores y logo (para ingresar con el código)
      allow list: if isSuper();
      allow write: if isSuper();
      function tOn()    { return get(/databases/$(db)/documents/sindicatos/$(sid)).data.activo != false; }
      function tAdmin() { return isSuper() || (signedIn() && exists(/databases/$(db)/documents/sindicatos/$(sid)/admins/$(request.auth.uid))); }
      function tOwner() { return isSuper() || (signedIn() && exists(/databases/$(db)/documents/sindicatos/$(sid)/admins/$(request.auth.uid))
        && get(/databases/$(db)/documents/sindicatos/$(sid)/admins/$(request.auth.uid)).data.rol == 'administrador'); }
      function tActive() { return signedIn() && tOn() && get(/databases/$(db)/documents/sindicatos/$(sid)/socios/$(request.auth.uid)).data.estado == 'activo'; }
      function tNombre() { return get(/databases/$(db)/documents/sindicatos/$(sid)/socios/$(request.auth.uid)).data.nombre; }
      match /admins/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || tAdmin());
        allow create, update: if request.resource.data.keys().hasOnly(['rol'])
          && ((tOwner() && request.resource.data.rol == 'dirigente') || (isSuper() && request.resource.data.rol == 'administrador'));
        allow delete: if (tOwner() && resource.data.rol == 'dirigente') || isSuper();
      }
      match /socios/{uid} {
        allow read: if (signedIn() && request.auth.uid == uid) || tAdmin();
        allow create: if signedIn() && request.auth.uid == uid && tOn()
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.keys().hasOnly(['nombre','rut','num','telefono','email','estado','creado']);
        allow update: if tAdmin();
        allow delete: if tAdmin() || (signedIn() && request.auth.uid == uid);
      }
      match /{col}/{id} {
        allow read: if contenido(col) && (tActive() || tAdmin());
        allow write: if contenido(col) && tAdmin();
      }
      match /plantillas/{id} { allow read, write: if tAdmin(); }
      match /asistencias/{rid} {
        allow read: if tActive() || tAdmin();
        allow write: if tAdmin();
        match /privado/{doc} { allow read, write: if tAdmin(); }
        match /presentes/{uid} {
          allow read: if tActive() || tAdmin();
          allow create: if tAdmin() || (tActive() && request.auth.uid == uid
            && get(/databases/$(db)/documents/sindicatos/$(sid)/asistencias/$(rid)).data.abierta == true
            && request.resource.data.codigo == get(/databases/$(db)/documents/sindicatos/$(sid)/asistencias/$(rid)/privado/clave).data.codigo
            && request.resource.data.via == 'codigo'
            && request.resource.data.keys().hasOnly(['nombre','num','codigo','via','t']));
          allow update, delete: if tAdmin();
        }
      }
      match /informativos/{pid}/likes/{uid} {
        allow read: if tActive() || tAdmin();
        allow create: if request.auth.uid == uid && request.resource.data.keys().hasOnly(['nombre','t'])
          && (tAdmin() || (tActive() && request.resource.data.nombre == tNombre()));
        allow delete: if (signedIn() && request.auth.uid == uid) || tAdmin();
      }
      match /informativos/{pid}/comentarios/{cid} {
        allow read: if tActive() || tAdmin();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','nombre','num','texto','t'])
          && request.resource.data.texto is string && request.resource.data.texto.size() > 1 && request.resource.data.texto.size() <= 500
          && (tAdmin() || (tActive() && request.resource.data.nombre == tNombre()));
        allow delete: if tAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      }
      match /encuestas/{pid}/votos/{uid} {
        allow read: if tActive() || tAdmin();
        allow create: if (tActive() || tAdmin()) && request.auth.uid == uid && request.resource.data.keys().hasOnly(['opcion','t']);
      }
    }
  }
}
